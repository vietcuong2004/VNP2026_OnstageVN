# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
!.env.local.example

#vscode
.vscode

# local tunnel executables
cloudflared.exe
ngrok.exe

# Publish only curated sample profiles and their display images.
/public/mock_data/*
!/public/mock_data/profiles.json
!/public/mock_data/Talent_Image/
/public/mock_data/Talent_Image/*
!/public/mock_data/Talent_Image/[0-9]*/
/public/mock_data/Talent_Image/[0-9]*/*
!/public/mock_data/Talent_Image/[0-9]*/avatar.jpg
!/public/mock_data/Talent_Image/[0-9]*/avatar.png
!/public/mock_data/Talent_Image/[0-9]*/cover.jpg
!/public/mock_data/Talent_Image/[0-9]*/lookbook_*.jpg
